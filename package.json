{
  "name": "@repo/monorepo",
  "version": "1.0.0",
  "description": "Case management app which streamlines case information entry",
  "author": "lexus",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prepare": "lefthook install",
    "check-types": "turbo check-types --continue",
    "check-format": "oxfmt --check",
    "dev": "turbo dev",
    "format": "oxfmt",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2006",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  }
}
