{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": [".env", "**/.env.*local"],
  "globalEnv": ["PORT", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "outputLogs": "new-only",
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.demo-mono-ts", ".env.local"],
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
    },
    "coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
    },
    "check-types": {
      "dependsOn": ["^build"],
    },
    "clean": {
      "cache": false,
    },
    "dev": {
      "cache": false,
      "persistent": true,
    },
  },
}
